---
import '../styles/global.css';
import { imageURL, safeJSON } from '../lib/seo';
const { title = 'Записи', description = 'Практические статьи о разработке, Home Assistant, AI-ботах, автомобилях и электронике.', noindex = false, image = imageURL('index'), article = null, structuredData = null } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{title} — volonterski</title><meta name="description" content={description} />
  <link rel="canonical" href={canonical} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="volonterski" href="/rss.xml" />
  <meta property="og:site_name" content="volonterski.ru" /><meta property="og:title" content={title} /><meta property="og:description" content={description} />
  <meta property="og:type" content={article ? 'article' : 'website'} /><meta property="og:url" content={canonical} /><meta property="og:locale" content="ru_RU" />
  <meta property="og:image" content={image} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content={image} />
  {article && <><meta property="article:published_time" content={article.date.toISOString()} /><meta property="article:modified_time" content={(article.updated || article.date).toISOString()} />{article.tags.map((tag: string) => <meta property="article:tag" content={tag} />)}</>}
  {structuredData && <script is:inline type="application/ld+json" set:html={safeJSON(structuredData)} />}
  {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />}
  {import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION && <meta name="yandex-verification" content={import.meta.env.PUBLIC_YANDEX_SITE_VERIFICATION} />}
  {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION} />}
  {noindex && <meta name="robots" content="noindex" />}
  <script is:inline>try { const t=localStorage.getItem('theme'); document.documentElement.dataset.theme=t==='dark'||t==='light'?t:(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'); } catch {}</script>
</head>
<body>
  <a class="skip" href="#main">К содержимому</a>
  <div class="shell">
    <header class="header">
      <nav aria-label="Основная навигация">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Записи</a>
        <button id="theme-toggle" class="theme-toggle" aria-label="Переключить тему" title="Переключить тему">
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13.1A8.5 8.5 0 0 1 10.9 3.5a8.5 8.5 0 1 0 9.6 9.6Z"/></svg>
        </button>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer><a href="/rss.xml">RSS</a><button id="analytics-settings" type="button" class="analytics-settings">Об аналитике</button></footer>
  </div>
  {import.meta.env.PUBLIC_ANALYTICS_ENDPOINT && <script is:inline src="/metrics.js" data-own-analytics data-endpoint={import.meta.env.PUBLIC_ANALYTICS_ENDPOINT} defer />}
  <script is:inline src="/analytics.js" data-analytics-config data-umami-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || ''} data-clarity-id={import.meta.env.PUBLIC_CLARITY_PROJECT_ID || ''} defer></script>
  <style is:global>
    .analytics-settings { appearance:none; border:0; padding:0; background:none; color:inherit; font:inherit; cursor:pointer; text-decoration:underline; text-underline-offset:3px; margin-left:16px; }
    .analytics-consent { position:fixed; z-index:200; bottom:12px; left:50%; transform:translateX(-50%); width:min(360px,calc(100% - 24px)); box-sizing:border-box; background:var(--bg,Canvas); color:var(--text,CanvasText); border:1px solid currentColor; border-radius:10px; padding:10px 12px; box-shadow:0 6px 24px #0002; display:flex; gap:10px; align-items:center; }
    .analytics-consent p { font-size:.76rem; line-height:1.35; margin:0; min-width:0; flex:1; }
    .analytics-consent button { font:inherit; font-size:.76rem; white-space:nowrap; padding:7px 9px; border:1px solid currentColor; border-radius:7px; background:transparent; color:inherit; cursor:pointer; flex-shrink:0; }
    @media(max-width:400px) { .analytics-consent { gap:7px; padding:9px; } .analytics-consent p { font-size:.72rem; } .analytics-consent button { font-size:.72rem; padding:6px; } }
  </style>
  <script>
    const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
    toggle?.addEventListener('click', () => { const dark=document.documentElement.dataset.theme==='dark'; const theme=dark?'light':'dark'; document.documentElement.dataset.theme=theme; try { localStorage.setItem('theme',theme); } catch {} });
    document.querySelectorAll('pre').forEach(pre => { const btn=document.createElement('button'); btn.className='copy-code'; btn.textContent='Копировать'; btn.setAttribute('aria-label','Копировать код'); btn.addEventListener('click',async()=>{try {await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || ''); btn.textContent='Скопировано';} catch {btn.textContent='Не удалось';} setTimeout(()=>btn.textContent='Копировать',2000);}); pre.append(btn); });
  </script>
</body></html>
